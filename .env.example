# Copia este archivo como .env y coloca la cadena de conexión de Redis Cloud.
#
# Plan Free / Essentials sin TLS  ->  redis://
# Plan de pago con TLS activado   ->  rediss://
#
# El endpoint y el puerto NO son 6379: cópialos del panel (Configuration >
# Public endpoint) y la contraseña de Security > Default user.
REDIS_URL=redis://default:TU_PASSWORD@TU_HOST:TU_PUERTO
